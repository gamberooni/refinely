# Refinely configuration — copy to .env and fill in your values.
# All variables are prefixed with REFINELY_ (pydantic-settings env_prefix).

# Required for real API calls. Set to your OpenAI API key (sk-...).
# Plain OPENAI_API_KEY works as a fallback if REFINELY_OPENAI_API_KEY is unset.
REFINELY_OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint (gateway/proxy). Leave empty for api.openai.com.
REFINELY_BASE_URL=http://localhost:4000/v1

# Model used for app calls and LLM judging.
REFINELY_MODEL_NAME=deepseek-v4-flash

# SQLite database path for lineage + Optuna trial storage.
REFINELY_LINEAGE_DB_PATH=lineage.db
